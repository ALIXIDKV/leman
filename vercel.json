{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/tools", "destination": "/home", "permanent": true },
    { "source": "/tools.html", "destination": "/home", "permanent": true },
    { "source": "/index.html", "destination": "/home", "permanent": true },
    { "source": "/market.html", "destination": "/store", "permanent": true },
    { "source": "/kontak.html", "destination": "/contact", "permanent": true }
  ],
  "rewrites": [{ "source": "/((?!admin|assets|js|static).*)", "destination": "/index.html" }]
}
